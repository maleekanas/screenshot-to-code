# At least one of OPENAI_API_KEY, ANTHROPIC_API_KEY or GEMINI_API_KEY is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Strongly recommended: powers asset extraction and video mode.
GEMINI_API_KEY=
# Strongly recommended: image generation, editing and background removal.
REPLICATE_API_KEY=

# Optional: OpenAI-compatible proxy endpoint.
# OPENAI_BASE_URL=

# Optional: where uploaded/generated assets are stored and served from.
# LOCAL_ASSET_DIR=/app/local_assets
# LOCAL_ASSET_BASE_URL=http://127.0.0.1:7001

# Optional debugging
# IS_DEBUG_ENABLED=true
# PROMPT_REPORTS_ENABLED=true
