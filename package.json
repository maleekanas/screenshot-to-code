{
  "name": "screenshot-to-code",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "dev:backend": "node scripts/dev.mjs backend",
    "bootstrap": "bash scripts/setup.sh",
    "build": "pnpm -C frontend build",
    "preview": "pnpm -C frontend preview",
    "lint": "pnpm -C frontend lint",
    "typecheck": "cd backend && poetry run pyright",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm -C frontend test",
    "test:backend": "cd backend && poetry run pytest",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "packageManager": "pnpm@10.32.1"
}
